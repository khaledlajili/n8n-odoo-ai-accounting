        }
      },
      "id": "n-po",
      "name": "Find Purchase Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -20
      ]
    },
    {
      "parameters": {
        "jsCode": "const getResult = (nodeName) => {\n  try {\n    return ($(nodeName).all() || []).flatMap(i => i.json?.result || []);\n  } catch (e) { return []; }\n};\nconst vat    = getResult('Find Supplier by VAT');\nconst byName = getResult('Find Supplier by Name');\nconst po     = getResult('Find Purchase Order');\nconst seen = new Set();\nconst suppliers = [];\nfor (const s of [...vat, ...byName]) {\n  if (s && s.id != null && !seen.has(s.id)) { seen.add(s.id); suppliers.push(s); }\n}\nconst invoice = $('Prepare Search Terms').first().json.invoice;\nreturn [{ json: { invoice, supplier_candidates: suppliers, po_candidates: po } }];"
      },

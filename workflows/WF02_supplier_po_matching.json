        "jsonBody": "={\n  \"model\": \"res.partner\",\n  \"domain\": [[\"name\", \"ilike\", \"{{ $('Prepare Search Terms').item.json.name }}\"], [\"supplier_rank\", \">\", 0]],\n  \"fields\": [\"id\",\"name\",\"vat\"],\n  \"limit\": 10\n}",
        "options": {
          "timeout": 15000
        }
      },

        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"purchase.order\",\n  \"domain\": [[\"name\", \"=\", \"{{ $('Prepare Search Terms').item.json.po }}\"]],\n  \"fields\": [\"id\",\"name\",\"partner_id\",\"amount_total\",\"currency_id\",\"state\"],\n  \"limit\": 5\n}",
        "options": {

    {
      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst inv = b.invoice || b;\nconst rid = b.request_id || inv.request_id || (inv.invoice_number ? 'REQ-' + inv.invoice_number : 'REQ-' + Date.now());\nreturn [{ json: {\n  invoice: inv, request_id: rid,\n  taxId: String(inv.supplier_tax_id || ''),\n  name: String(inv.supplier_name || ''),\n  po: String(inv.purchase_order_number || '')\n} }];"
      },
      "id": "n-prep",
      "name": "Prepare Search Terms",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://validator:8000/odoo/search_read",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"res.partner\",\n  \"domain\": [[\"vat\", \"=\", \"{{ $json.taxId }}\"], [\"supplier_rank\", \">\", 0]],\n  \"fields\": [\"id\",\"name\",\"vat\"],\n  \"limit\": 5\n}",
        "options": {
          "timeout": 15000
        }
      },

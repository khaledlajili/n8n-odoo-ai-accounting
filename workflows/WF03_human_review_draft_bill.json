    {
      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst action = String(b.action || '').toLowerCase();\nif (!['prepare','decide'].includes(action)) {\n  return [{ json: { error: \"invalid action; expected 'prepare' or 'decide'\", action } }];\n}\nreturn [{ json: { action, payload: b } }];"
      },
      "id": "n-route",
      "name": "Route Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "prepare",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "prepare"
            },
            {

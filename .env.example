# Copy to .env and fill in real values (or use the bootstrap in docs/SETUP.md).
# NEVER commit .env. It is gitignored.

# ---- Project ----
PROJECT_NAME=n8n-odoo-ai-accounting
TZ=Europe/Berlin

# ---- PostgreSQL superuser ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_superuser
POSTGRES_DB=postgres

# ---- Odoo role (created by init script; needs CREATEDB) ----
ODOO_DB_USER=odoo_user
ODOO_DB_PASSWORD=change_me_odoo
ODOO_MASTER_PASSWORD=change_me_odoo_master
ODOO_DB_NAME=northstar

# ---- n8n role/database (created by init script) ----
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=change_me_n8n
N8N_DB_NAME=n8n_db
N8N_ENCRYPTION_KEY=change_me_64_hex_chars
